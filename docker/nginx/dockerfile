# 基础镜像
FROM nginx
# author
LABEL maintainer="beg"

# 挂载目录
VOLUME /home/antcloud/projects/antcloud-ui
# 创建目录
RUN mkdir -p /home/antcloud/projects/antcloud-ui
# 指定路径
WORKDIR /home/antcloud/projects/antcloud-ui
# 复制conf文件到路径
COPY ./conf/nginx.conf /etc/nginx/nginx.conf
# 复制html文件到路径
COPY ./html/dist /home/antcloud/projects/antcloud-ui
